{
  "name": "stripe-demo-backend",
  "version": "1.0.0",
  "description": "Backend server for Stripe Connect demo with account management and payments",
  "main": "server.js",
  "scripts": {
    "build:web": "esbuild src/web/terminalHardware.js --bundle --minify --platform=browser --outfile=public/terminal-hardware.js",
    "prestart": "npm run build:web",
    "predev": "npm run build:web",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test/accountStatus.test.js && node test/accountList.test.js && node test/marketConfig.test.js && node test/payments.test.js && node test/terminalService.test.js",
    "build": "npm run build:web",
    "vercel-build": "npm run build:web"
  },
  "keywords": [
    "stripe",
    "connect",
    "payments",
    "payouts",
    "express",
    "vercel"
  ],
  "author": "Aditya Singh <adityasingh@stripe.com>",
  "license": "MIT",
  "dependencies": {
    "@stripe/connect-js": "^3.4.7-preview.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
